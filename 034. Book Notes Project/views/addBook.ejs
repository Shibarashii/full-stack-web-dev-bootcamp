<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Add Book</title>
    <link rel="stylesheet" href="/styles/output.css">
</head>

<body>
    <%- include('partials/header') %>
        <main class="p-10 flex justify-center items-center">
            <div class="border border-black p-10 rounded-2xl bg-amber-50">
                <h1 class="title"> Add book </h1>
                <br>
                <% if (typeof message !=='undefined' && message) { %>
                    <p class="text-green-700 mb-4" role="status">
                        <%= message %>
                    </p>
                    <% } %>
                        <% if (typeof error !=='undefined' && error) { %>
                            <p class="text-red-700 mb-4" role="alert">
                                <%= error %>
                            </p>
                            <% } %>
                                <form action="/add" method="post" class="flex flex-col [&_input]:mb-4">
                                    <label for="title"> Title </label>
                                    <input type="text" name="title" id="title" required>

                                    <label for="author"> Author </label>
                                    <input type="text" name="author" id="author" required>

                                    <label for="isbn"> ISBN </label>
                                    <input type="text" name="isbn" id="isbn" required>

                                    <label for="dateRead"> Date Read </label>
                                    <input type="date" name="dateRead" id="date-read" required>

                                    <label for="rating"> Rating </label>
                                    <input type="number" name="rating" id="rating" min="1" max="10" required>

                                    <label for="review"> Review </label>
                                    <textarea name="review" id="review" class="mb-4"></textarea>

                                    <button class="primary-button self-end" type="submit"> Add book </button>
                                </form>

            </div>
        </main>
        <%- include('partials/footer') %>

</body>

</html>